# Browser API root. Keep /api/v1 in development so Vite can proxy same-origin requests.
VITE_API_BASE_URL=/api/v1

# Optional local backend target used by the Vite proxy.
VITE_DEV_PROXY_TARGET=http://localhost:8080
# Optional direct loopback address used in the local executor launch command.
# Set this when the Vite proxy is not the backend address, for example Python at 8000.
VITE_NODE_SERVER_URL=
