# Browser API root. Keep /api/v1 in development so Vite can proxy same-origin requests.
VITE_API_BASE_URL=/api/v1

# Optional local backend target used by the Vite proxy and source-checkout executor command in development.
VITE_DEV_PROXY_TARGET=http://localhost:8080
# Optional direct loopback address used in the local executor launch command.
# Set this when the Vite proxy is not the backend address, for example Python at 8000.
VITE_NODE_SERVER_URL=

# Optional browser-reachable launcher used by the Nodes page's one-click local executor start.
VITE_LOCAL_EXECUTOR_LAUNCHER_URL=http://127.0.0.1:8094

# Optional published Windows companion package. When set, the Nodes page shows a download action
# instead of the source-checkout Gradle fallback command.
VITE_WINDOWS_COMPANION_DOWNLOAD_URL=
